# SPA → API bridge (optional)
# When set, login tries the backend first (hashed passwords), then falls back
# to in-memory seed accounts unless VITE_API_FALLBACK=false.
VITE_API_URL=http://localhost:4000
# VITE_API_FALLBACK=false

# --- Vercel production example ---
# VITE_API_URL=https://kacyiru-api.onrender.com
# VITE_API_FALLBACK=true

# --- Real launch (Protocol / Music) ---
# No demo logins in the browser, no demo roster; people and offices come from the server.
# VITE_API_FALLBACK=false
# VITE_DEMO_SEED=false

# --- Which site this build is ---
# VITE_APP_ENV=staging     shows a "TEST SITE" ribbon and the connection badge
# VITE_APP_ENV=production  the build FAILS unless VITE_API_URL is set and
#                          VITE_API_FALLBACK=false and VITE_DEMO_SEED=false; hides the badge
