  /// The choir's own system (sys-choir or sys-worship), whose leaders may manage its register
  systemId    String?
  orgUnitId   String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
}

model MusicChoirMember {
  id       String   @id @default(cuid())
  choirId  String
  personId String
  /// ACTIVE | LEFT
  status   String   @default("ACTIVE")
  joinedOn DateTime @default(now())

