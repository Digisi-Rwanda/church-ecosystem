  @@index([personId])
}

/// The month plan: one per month, DRAFT until published.
model MusicPlan {
  id          String    @id @default(cuid())
  /// YYYY-MM
  periodKey   String    @unique
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
}

model MusicService {
  id        String   @id @default(cuid())
  planId    String
  serviceOn DateTime
  /// SS1 | SS2 | TUESDAY | FRIDAY | IGABURO
  kind      String
  label     String?
  /// ACTIVE | REMOVED
  status    String   @default("ACTIVE")

