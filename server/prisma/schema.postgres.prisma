  recordedById String
  recordedAt   DateTime  @default(now())

  @@index([sponsorId])
}

/* ─── Protocol: the old team engine (slice 3.16) ─── */

/// A person on the Protocol roster: office, which days they can serve and the limits their leader set.
model ProtocolRoster {
  id               String   @id @default(cuid())
  personId         String   @unique
  /// PRESIDENT | VP | SECRETARY | TREASURER | COORDINATOR | MEMBER
  office           String   @default("MEMBER")
  /// SUNDAY | TUESDAY | BOTH
  serveDays        String   @default("BOTH")
  /// ACTIVE | INACTIVE | LEAVE
  status           String   @default("ACTIVE")
  unavailableJson  String   @default("[]")
  allowedKindsJson String   @default("[]")
  onlyServicesJson String   @default("[]")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
}

/// One month of teams. Status OPEN, DRAFT, REVIEW, PUBLISHED; the version rises with each publish.
model ProtocolPlan {
  id                String    @id @default(cuid())
  monthKey          String    @unique
  status            String    @default("OPEN")
  version           Int       @default(0)
  notesJson         String    @default("[]")
  generatedAt       DateTime?
  submittedAt       DateTime?
  submittedById     String?
  reviewedAt        DateTime?
  reviewedById      String?
  publishedAt       DateTime?
  publishedById     String?
  musicVersionBuiltOn Int?
  musicSnapshotJson String?
  musicStaleNotified Boolean  @default(false)
  overridesJson     String    @default("[]")
  relaxTuesday      Boolean   @default(false)
  relaxReason       String?
  relaxedById       String?
  relaxedAt         DateTime?
  updatedAt         DateTime  @default(now())
  /// The scheduling-config version this plan was built against, so the plan
  /// stays reproducible and stale-detection can compare config versions.
  configVersionId   String?
  configVersion     ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@index([configVersionId])
}

/// A person on a service's team. Removed rows are deleted from the working plan; published versions keep a snapshot.
model ProtocolSlot {
  id               String @id @default(cuid())
  monthKey         String
  serviceId        String
  personId         String
  /// ENGINE | MANUAL | FILL_IN | SWAP
  source           String @default("MANUAL")
  /// MEMBER | TEAM_LEADER | VICE_LEADER
  role             String @default("MEMBER")
  recommendedRole  String?
  roleStatus       String?
  /// REGULAR | EXTRA | FILL_IN
  slotKind         String @default("REGULAR")
  replacedPersonId String?

  @@index([monthKey])
  @@index([serviceId])
}

/// An immutable snapshot of a month each time it is published.
model ProtocolHistory {
  id            String   @id @default(cuid())
  monthKey      String
  version       Int
  publishedAt   DateTime @default(now())
  publishedById String
  slotsJson     String
  notesJson     String   @default("[]")
  /// The Protocol rules version used to generate and publish this snapshot.
  configVersionId String?
  configVersion ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@unique([monthKey, version])
  @@index([configVersionId])
}

/// Present, half present, excused or absent: one row per person per service.
model ProtocolAttendance {
  id           String   @id @default(cuid())
  serviceId    String
  personId     String
  status       String
  slotKind     String?
  notes        String?
  recordedById String
  recordedAt   DateTime @default(now())

  @@unique([serviceId, personId])
}

/// A member asks their team leader to excuse them.
model ProtocolAbsence {
  id          String    @id @default(cuid())
  serviceId   String
  personId    String
  reason      String
  /// PENDING | EXCUSED | DENIED
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  decidedById String?
  decidedAt   DateTime?

  @@index([serviceId])
}

/// A leader offers an excused person's place to someone; the candidate accepts or declines.
model ProtocolFillIn {
  id               String    @id @default(cuid())
  serviceId        String
  excusedPersonId  String
  candidatePersonId String
  offeredById      String
  /// PENDING | ACCEPTED | DECLINED | CANCELLED
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now())
  respondedAt      DateTime?

  @@index([serviceId])
}

/// A member proposes to swap into another member's service; the other accepts or declines.
model ProtocolSwapProposal {
  id            String    @id @default(cuid())
  serviceId     String
  proposerId    String
  targetId      String
  /// PENDING | ACCEPTED | DECLINED | CANCELLED
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?

  @@index([serviceId])
}

/// What the team leader writes after a service; Deacon reads these. One per service.
model ProtocolServiceReport {
  id              String   @id @default(cuid())
  serviceId       String   @unique
  monthKey        String
  authorId        String
  challenges      String   @default("")
  solutions       String   @default("")
  issues          String   @default("")
  recommendations String   @default("")
  submittedAt     DateTime @default(now())

  @@index([monthKey])
}

/* ─── Music schedule engine (slice 3.16) ─── */

/// A generated or hand-edited choir schedule for one or more months, not yet confirmed. Documents, as in the old system.
model MusicDraft {
  id             String   @id @default(cuid())
  label          String
  /// MONTH | QUARTER | HALF | YEAR
  horizon        String
  startMonth     String
  servicesJson   String
  assignmentsJson String
  warningsJson   String   @default("[]")
  createdById    String
  createdAt      DateTime @default(now())
  /// The Music rules version used to generate and validate this draft.
  configVersionId String?
  configVersion ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@index([configVersionId])
}

/// A month the Music team has confirmed (Protocol may plan against it) or published (the choirs see it).
model MusicMonth {
  id              String    @id @default(cuid())
  periodKey       String    @unique
  /// CONFIRMED | PUBLISHED
  state           String
  version         Int       @default(1)
  batchId         String?
  batchHorizon    String?
  servicesJson    String
  assignmentsJson String
  warningsJson    String    @default("[]")
  confirmedAt     DateTime
  confirmedById   String
  publishedAt     DateTime?
  publishedById   String?
  updatedAt       DateTime
  updatedById     String?
  /// The scheduling-config version this confirmed/published month was generated
  /// and validated against, so the month stays reproducible.
  configVersionId String?
  configVersion   ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@index([configVersionId])
}

/// Every confirm, publish and edit of a month, kept for good.
model MusicLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  periodKey   String
  /// CONFIRMED | PUBLISHED
  stage       String
  /// CONFIRMED | RECONFIRMED | PUBLISHED | EDITED
  action      String
  version     Int
  byId        String
  summary     String
  changesJson String   @default("[]")
  /// Version and full schedule state at this logged transition.
  configVersionId String?
  configVersion ConfigVersion? @relation(fields: [configVersionId], references: [id])
  servicesSnapshotJson String?
  assignmentsSnapshotJson String?

  @@index([periodKey])
  @@index([configVersionId])
}

/// The preferences of one system: unit details and money options, as JSON (slice 3.18).
model SystemSetting {
  id          String   @id @default(cuid())
  systemId    String   @unique
  detailsJson String   @default("{}")
  moneyJson   String   @default("{}")
  updatedById String?
  updatedAt   DateTime @default(now())
}

/// Money block, Module 5 (slice 3.19). One planned amount per category per year; actuals come from MoneyEntry.
model MoneyBudget {
  id           String    @id @default(cuid())
  systemId     String
  year         Int
  /// DRAFT | SUBMITTED | APPROVED
  status       String    @default("DRAFT")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([systemId, year])
}

model MoneyBudgetLine {
  id          String   @id @default(cuid())
  systemId    String
  year        Int
  /// INCOME | SPENDING
  kind        String
  category    String
  planned     Int
  note        String?
  updatedById String
  updatedAt   DateTime @default(now())

  @@unique([systemId, year, kind, category])
}

/// A unit's approved budget sent to Central as a frozen report. Append-only; the newest per system and year counts.
model MoneyBudgetSubmission {
  id            String   @id @default(cuid())
  systemId      String
  year          Int
  snapshotJson  String
  submittedById String
  submittedAt   DateTime @default(now())
  /// SUBMITTED | APPROVED | RETURNED | WITHDRAWN
  status        String   @default("SUBMITTED")
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  @@index([systemId, year])
}

/// The money action plan: planned activities with an estimated cost.
model MoneyPlanItem {
  id          String   @id @default(cuid())
  systemId    String
  year        Int
  title       String
  amount      Int
  /// YYYY-MM, optional
  dueMonth    String?
  category    String?
  /// PLANNED | DONE | DROPPED
  status      String   @default("PLANNED")
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  /// Optional link to the program, project or event (WorkPlan) this activity belongs to
  planId      String?
  /// Where the money for this activity comes from: CONTRIBUTION (a contribution type of the unit) | DONATION | OTHER
  fundingKind String?
  /// The contribution type code, when the funding is a contribution
  fundingCode String?
  fundingNote String?
  /// The Treasurer's check of this line while its activity is being approved: VERIFIED | MODIFIED (changed after it was verified)
  checkState  String?
  checkedById String?
  checkedAt   DateTime?
  /// A project's cost line belongs to one of its milestones (its phase); empty means the automatic General phase
  milestoneId String?

  @@index([systemId, year])
  @@index([planId])
}

/// A contribution list: a team's list for a month, or the unit's (combined or recorded directly).
model ContributionList {
  id             String    @id @default(cuid())
  systemId       String
  /// TEAM | UNIT
  level          String
  typeCode       String
  typeName       String
  /// YYYY-MM
  month          String
  teamUnitId     String?
  teamName       String?
  /// DRAFT | SUBMITTED | COMBINED | APPROVED | RETURNED
  status         String    @default("DRAFT")
  /// JSON array of the team list ids a unit list was combined from
  sourceListIds  String    @default("[]")
  createdById    String
  createdAt      DateTime  @default(now())
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  /// Restricted use of a unit list, such as a special collection: "" (unrestricted), A:<planId> or C:<category>
  purpose        String    @default("")

  @@index([systemId, month])
}

model ContributionLine {
  id        String  @id @default(cuid())
  listId    String
  name      String
  personId  String?
  team      String?
  amount    Int

  @@index([listId])
  @@index([personId])
}

/// A donation: recorded by the treasurer or vice president, approved by the president, then it is income.
model Donation {
  id           String    @id @default(cuid())
  systemId     String
  accountId    String
  donorName    String
  /// The member who gave, when the treasurer picked one (optional)
  donorPersonId String?
  amount       Int
  receivedOn   DateTime
  note         String?
  /// PENDING | APPROVED | REJECTED
  status       String    @default("PENDING")
  recordedById String
  recordedAt   DateTime  @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  entryId      String?

  @@index([systemId, status])
  @@index([donorPersonId])
  typeCode    String?
  typeName    String?
  /// "" (unrestricted), A:<planId> or C:<category>
  purpose     String   @default("")
}

/// A file kept on a person's profile (a certificate, a letter, an ID copy). Stored as base64 text; small files only.
model PersonDocument {
  id           String    @id @default(cuid())
  personId     String
  name         String
  mime         String
  size         Int
  dataBase64   String
  note         String?
  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?

  @@index([personId])
}

/// A good deed of a member, recorded by a Unit Secretary (or the Church Secretary, Pastor, Church Leader).
model PersonDeed {
  id           String    @id @default(cuid())
  personId     String
  note         String
  day          String
  recordedById String
  unitId       String?
  recordedAt   DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?

  @@index([personId])
}

/// What was given at one church service or event: recorded by the Church Treasurer, read by the Church Leader.
/// Kept apart from Money and from activities on purpose.
model ServiceCollection {
  id           String    @id @default(cuid())
  systemId     String    @default("sys-main")
  /// SERVICE | EVENT
  kind         String    @default("SERVICE")
  title        String
  heldOn       DateTime
  /// HH:MM, optional
  startsAt     String?
  /// Whole Rwandan francs
  tithe        Int       @default(0)
  offering     Int       @default(0)
  /// Thanksgiving and any other giving
  other        Int       @default(0)
  note         String?
  /// ACTIVE | VOIDED
  status       String    @default("ACTIVE")
  voidReason   String?
  recordedById String
  recordedAt   DateTime  @default(now())
  updatedById  String?
  updatedAt    DateTime  @updatedAt

  @@index([systemId, heldOn])
}

/// Income the treasurer records as promised (PLEDGED) or received (SECURED). Only SECURED income counts toward what can be set aside.
/// A CONTRIBUTION or DONATION pledge is FULFILLED when the money arrives through a contribution list or a donation; OTHER income is SECURED here.
model IncomeRecord {
  id           String    @id @default(cuid())
  systemId     String
  /// CONTRIBUTION | DONATION | OTHER
  kind         String
  /// CONTRIBUTION: the unit's own contribution type. OTHER: the pot it sits in (POOL is the general pool). DONATION: empty.
  code         String    @default("")
  label        String
  amount       Int
  /// PLEDGED | SECURED | FULFILLED | CANCELLED
  status       String
  expectedOn   DateTime?
  receivedOn   DateTime?
  note         String?
  recordedById String
  recordedAt   DateTime  @default(now())
  updatedById  String?
  updatedAt    DateTime  @default(now())

  /// The fundraising event this record came from, if any
  planId       String?
  /// DONATION | CONTRIBUTION | GRANT | SPONSOR | OTHER: what kind of source it is. kind is the pot, code is the purpose ("", A:<planId>, C:<category>).
  sourceTag    String    @default("OTHER")
  /// Who approved it into the secured balance, when a donation or contribution needed the President
  approvedById String?
  approvedAt   DateTime?

  @@index([systemId, status])
}

/// Money set aside for an activity from one pot of its unit. A pot is a kind of source and its code.
model PlanSource {
  id          String   @id @default(cuid())
  planId      String
  systemId    String
  /// CONTRIBUTION | DONATION | OTHER
  kind        String
  code        String   @default("")
  amount      Int
  createdById String
  createdAt   DateTime @default(now())

  @@unique([planId, kind, code])
  @@index([planId])
  @@index([systemId])
}

/// A request to change an approved activity's money. TRANSFER keeps or lowers the total (the President decides; the Church Leader reviews it monthly);
/// INCREASE raises it (the Church Leader decides). While PENDING, an increase reserves its extra amount against the sources.
model BudgetAmendment {
  id            String    @id @default(cuid())
  planId        String
  systemId      String
  /// TRANSFER | INCREASE
  kind          String
  /// PENDING | APPROVED | REJECTED | WITHDRAWN
  status        String    @default("PENDING")
  oldTotal      Int
  newTotal      Int
  justification String
  /// The proposed full list of spending lines: [{id?, title, amount}]
  linesJson     String
  /// The proposed full list of sources: [{kind, code, amount}]
  sourcesJson   String
  /// What the amendment holds back while open: [{kind, code, amount}]
  reserveJson   String    @default("[]")
  requestedById String
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  reviewedById  String?
  reviewedAt    DateTime?
  /// MONEY (cost lines, set-aside sources) | GENERAL (schedule, mission, category or a combined change) | TEAM (leader, team)
  scope         String    @default("MONEY")
  /// The proposed changes to the activity's own fields: { keys: [...], set: {...} }
  changesJson   String?
  /// GENERAL: the chain of approvals: [{ levelKey, label, systemId, status, byId, at, note }]
  levelsJson    String?

  @@index([planId])
  @@index([systemId, status])
}

/// The Church Leader's monthly release of an ongoing program's money. A month with no row here is "Not released".
model PlanRenewal {
  id          String   @id @default(cuid())
  planId      String
  /// YYYY-MM
  month       String
  renewedById String
  renewedAt   DateTime @default(now())

  @@unique([planId, month])
  @@index([planId])
}

/// Money received by a fundraising event: ticket sales, auction proceeds, direct donations.
model PlanRevenue {
  id           String   @id @default(cuid())
  planId       String
  systemId     String
  label        String
  amount       Int
  receivedOn   DateTime
  recordedById String
  recordedAt   DateTime @default(now())
  /// PENDING (logged by the leader, waiting for the Treasurer) | CONFIRMED (counts toward the fundraiser)
  status       String   @default("CONFIRMED")
  confirmedById String?
  confirmedAt  DateTime?

  @@index([planId])
}

/// A file attached to an activity (a proposal, a letter, a budget sheet, a picture). Stored as base64 text; small files only.
model PlanFile {
  id           String    @id @default(cuid())
  planId       String
  name         String
  mime         String
  size         Int
  dataBase64   String
  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?

  @@index([planId])
}

/// A signed change to the secured money of one pot and purpose: overspend and late invoices taken from unrestricted money (negative).
model FundAdjustment {
  id          String   @id @default(cuid())
  systemId    String
  planId      String?
  /// CONTRIBUTION | DONATION
  kind        String
  code        String   @default("")
  amount      Int
  /// OVERSPEND | LATE_INVOICE | UNCOVERED (UNCOVERED never changes a balance: it is the part nothing could cover)
  reason      String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([systemId])
  @@index([planId])
}

/// One budget year of a program that goes on past its first: the Church Leader's yearly decision, what the year cost, and what went back.
model ProgramYear {
  id           String    @id @default(cuid())
  planId       String
  systemId     String
  year         Int
  /// PLANNED (needs funding) | ACTIVE | CLOSED | SKIPPED
  status       String
  /// The budget of the year: the Church Leader's Next Year Budget, then what the President set aside
  amount       Int       @default(0)
  spent        Int?
  returned     Int?
  attendance   Int?
  /// CONTINUE | CLOSE | END_EARLY | PREPARE | SKIP
  decision     String?
  note         String?
  decidedById  String?
  decidedAt    DateTime?
  fundedById   String?
  fundedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([planId, year])
  @@index([planId])
  @@index([systemId])
}

/// A cohort of a cohort-based program (a baptism class, a training round): one runs at a time, then it is closed into the history.
model ProgramCohort {
  id          String    @id @default(cuid())
  planId      String
  systemId    String
  name        String
  startsOn    DateTime
  endsOn      DateTime
  target      Int?
  enrolled    Int       @default(0)
  graduated   Int?
  /// The part of the program's yearly allowance given to this cohort; what it does not spend goes back to the program when it closes
  budget      Int       @default(0)
  spent       Int?
  /// ACTIVE | CLOSED
  status      String    @default("ACTIVE")
  notes       String?
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([planId])
  @@index([systemId])
}

/// A case of a case-based program (Sick Care, Needy Support): one person's need, registered by their unit leader.
model ProgramCase {
  id             String    @id @default(cuid())
  planId         String
  systemId       String
  /// SICK_CARE | NEEDY
  caseType       String
  unitId         String
  name           String
  contact        String    @default("")
  /// The sickness, or the narration of the need
  issue          String    @default("")
  /// What the person's unit can raise, what would make the difference, and the gap between them (never below zero)
  capacity       Int       @default(0)
  need           Int       @default(0)
  gap            Int       @default(0)
  /// What the church approved for this person and what the Treasurer has paid out
  approved       Int       @default(0)
  disbursed      Int       @default(0)
  /// PENDING | APPROVED | FOLLOW_UP | CLOSED
  status         String    @default("PENDING")
  /// The latest healing or resolution status written by the unit leader
  condition      String?
  batchId        String?
  /// RESOLVED | RECOVERED | PASSED | CANCELLED
  outcome        String?
  closeNote      String?
  registeredById String
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
  /// Marriage: JSON { p1Name, p1Contact, p2Name, p2Church, p2Contact, date, time, place, certificateFileId }
  detailsJson    String    @default("{}")
  verifiedById   String?
  verifiedAt     DateTime?
  /// Marriage: an open request to postpone or cancel: JSON { kind, reason, newDate, newTime, status: REQUESTED | CONFIRMED, byId, at }
  changeJson     String?

  @@index([planId])
  @@index([systemId])
}

/// A decision of the case manager on cases of one unit: PER_CASE (amounts named) or BLOCK (a lump sum the unit leader divides).
model ProgramCaseBatch {
  id          String    @id @default(cuid())
  planId      String
  systemId    String
  unitId      String
  /// PER_CASE | BLOCK
  mode        String
  amount      Int
  /// AWAITING_ALLOCATION | READY | PAID
  status      String
  decidedById String
  decidedAt   DateTime  @default(now())
  paidEntryId String?
  paidById    String?
  paidAt      DateTime?

  @@index([planId])
}

/// One line of a case's timeline.
model ProgramCaseEvent {
  id     String   @id @default(cuid())
  caseId String
  planId String
  /// REGISTERED | REVIEWED | ALLOCATED | PAID | PROGRESS | CLOSED
  kind   String
  text   String
  byId   String
  at     DateTime @default(now())

  @@index([caseId])
  @@index([planId])
}

/// A marriage case's announcements and preparation meetings.
model ProgramCaseItem {
  id          String   @id @default(cuid())
  caseId      String
  planId      String
  /// ANNOUNCEMENT | MEETING
  kind        String
  /// The church that announces, or where the meeting is held (free text)
  place       String   @default("")
  onDate      DateTime
  atTime      String?
  /// SCHEDULED | DONE | CANCELLED
  status      String   @default("SCHEDULED")
  createdById String
  createdAt   DateTime @default(now())

  @@index([caseId])
  @@index([planId])
}

/* ─── Configurable scheduling (Music & Protocol) ───

   Versioned, tenant-scoped configuration that replaces hard-coded church
   scheduling policy. Every row carries systemId (tenant), effectiveFrom /
   effectiveTo and status, so edits create a new version instead of
   overwriting history. schedules reference ConfigVersion to stay reproducible.
*/

/// One published snapshot of a church's scheduling configuration.
model ConfigVersion {
  id                 String   @id @default(cuid())
  systemId           String
  version            Int
  label              String
  status             String   @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED | SCHEDULED
  effectiveFrom      DateTime @default(now())
  effectiveTo        DateTime?
  createdByPersonId  String
  createdAt          DateTime @default(now())
  reason             String?
  previousVersionId  String?
  notesJson          String   @default("{}")
  validationJson     String   @default("{}")
  affectedSchedulesJson String @default("[]")
  musicMonths        MusicMonth[]
  musicDrafts        MusicDraft[]
  musicLogs           MusicLog[]
  protocolPlans      ProtocolPlan[]
  protocolHistories  ProtocolHistory[]
  schedulingServices SchedulingService[]
  choirCategories    ChoirCategory[]
  categoryServicePolicies CategoryServicePolicy[]
  choirCategoryLinks ChoirCategoryLink[]
  protocolServiceRules ProtocolServiceRule[]
  protocolDutyPolicies ProtocolDutyPolicy[]

  @@unique([systemId, version])
  @@index([systemId, status])
}

/// A church-defined service type / occurrence (replaces the fixed SS1, SS2,
/// TUESDAY, FRIDAY, IGABURO list). `code` is the stable identity referenced by
/// generated service IDs (`msvc-<date>-<code>`) and by Protocol; it never
/// changes once a schedule refers to it.
model SchedulingService {
  id                String   @id @default(cuid())
  systemId          String
  code              String   // stable slug, e.g. ss1, tuesday, igaburo
  name              String
  kind              String   @default("SERVICE") // SERVICE | REHEARSAL | MEETING | OTHER
  weekday           Int?     // 0 = Sunday … 6 = Saturday
  time              String?  // HH:MM
  recurrence        String   @default("WEEKLY") // WEEKLY | MONTHLY | SELECTED_DATES | CUSTOM
  selectedDatesJson String   @default("[]")
  active            Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  musicRequired     Boolean  @default(false)
  protocolRequired  Boolean  @default(false)
  /// Maximum number of choirs allowed on one service instance (legacy: 3 for SS1/SS2).
  maxChoirs         Int      @default(3)
  /// Target Protocol team size for this service (legacy: 10).
  targetTeamSize    Int      @default(10)
  /// The config version this row belongs to (snapshot integrity).
  configVersionId   String?
  configVersion     ConfigVersion? @relation(fields: [configVersionId], references: [id])
  displayOrder      Int      @default(0)
  supersedesId      String?
  createdByPersonId String
  createdAt         DateTime @default(now())

  @@unique([systemId, code, configVersionId])
  @@index([systemId, active])
  @@index([configVersionId])
}

/// A category of choirs (replaces the fixed PRIMARY, SECONDARY, CHILDREN,
/// WORSHIP roles). The name confers no automatic behavior — behavior comes
/// only from CategoryServicePolicy.
model ChoirCategory {
  id                String   @id @default(cuid())
  systemId          String
  code              String
  name              String
  description       String   @default("")
  active            Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  supersedesId      String?
  createdByPersonId String
  createdAt         DateTime @default(now())
  /// The config version this row belongs to (snapshot integrity).
  configVersionId   String?
  configVersion     ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@unique([systemId, code, configVersionId])
  @@index([systemId, active])
  @@index([configVersionId])
}

/// Policy for one category × one service: eligibility + frequency target.
model CategoryServicePolicy {
  id                String   @id @default(cuid())
  systemId          String
  categoryId        String
  serviceId         String
  eligible          Boolean  @default(true)
  active            Boolean  @default(true)
  frequencyTarget   Int?     // null = no fixed target
  frequencyCounting String   @default("ASSIGNMENTS") // ASSIGNMENTS | DISTINCT_DATES
  frequencyKind     String   @default("TARGET")    // MINIMUM | TARGET | MAXIMUM
  planningMode      String   @default("ROTATION")  // ROTATION | FIXED | MANUAL
  /// Minimum number of this category required on the service (legacy: Tuesday=1 primary, Igaburo=2 primaries).
  minCount          Int?
  /// Maximum number of this category allowed on the service (legacy: PRIMARY=1 per service, max 3 total).
  maxCount          Int?
  /// If true, every eligible member of this category must be scheduled on the service (legacy: all Worship on Tuesday).
  requireAll        Boolean  @default(false)
  /// The config version this row belongs to (snapshot integrity).
  configVersionId   String?
  configVersion     ConfigVersion? @relation(fields: [configVersionId], references: [id])
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  supersedesId      String?
  createdByPersonId String
  createdAt         DateTime @default(now())

  @@unique([systemId, categoryId, serviceId, configVersionId], map: "CategoryServicePolicy_config_version_key")
  @@index([systemId, categoryId])
  @@index([configVersionId])
}

/// Links a choir to a category, with optional per-choir eligibility / frequency overrides.
model ChoirCategoryLink {
  id                   String   @id @default(cuid())
  systemId             String
  choirId              String   // references MusicChoir.id
  categoryId           String
  eligibleOverrideJson String   @default("{}")       // { eligible: boolean }
  frequencyOverrideJson String  @default("{}")       // per-service overrides
  active               Boolean  @default(true)
  effectiveFrom        DateTime @default(now())
  effectiveTo          DateTime?
  supersedesId         String?
  createdByPersonId    String
  createdAt            DateTime @default(now())
  /// The config version this row belongs to (snapshot integrity).
  configVersionId      String?
  configVersion        ConfigVersion? @relation(fields: [configVersionId], references: [id])

  @@unique([systemId, choirId, configVersionId])
  @@index([systemId, categoryId])
  @@index([configVersionId])
}

/// Protocol staffing rule for one service.
model ProtocolServiceRule {
  id                   String   @id @default(cuid())
  systemId             String
  serviceId            String   // references SchedulingService.id
  active               Boolean  @default(true)
  required             Boolean  @default(false)
  defaultTeamSize      Int      @default(10)
  teamSizeOverridesJson String  @default("{}")       // { serviceId: size }
  requireChoir         Boolean  @default(true)
  requireWorship       Boolean  @default(true)
  relaxableKindsJson   String   @default("[]")
  /// The config version this row belongs to (snapshot integrity).
  configVersionId      String?
  configVersion        ConfigVersion? @relation(fields: [configVersionId], references: [id])
  effectiveFrom        DateTime @default(now())
  effectiveTo          DateTime?
  supersedesId         String?
  createdByPersonId    String
  createdAt            DateTime @default(now())

  @@unique([systemId, serviceId, configVersionId])
  @@index([configVersionId])
}

/// Monthly Protocol duty policy (replaces the hard-coded target 3 / max 4 / team 10).
model ProtocolDutyPolicy {
  id                     String   @id @default(cuid())
  systemId               String
  preferTarget           Int      @default(3)
  softMax                Int      @default(3)
  hardMax                Int      @default(4)
  extraDutyPolicy        String   @default("ALLOW_WHEN_SHORT") // ALLOW_WHEN_SHORT | NEVER | ALWAYS
  duplicateSameDayAllowed Boolean @default(false)
  musicCompatibilityRequired Boolean @default(true)
  leadershipPrioritiesJson String  @default("[]")
  exceptionsAllowed      Boolean  @default(true)
  /// The config version this row belongs to (snapshot integrity).
  configVersionId        String?
  configVersion          ConfigVersion? @relation(fields: [configVersionId], references: [id])
  effectiveFrom          DateTime @default(now())
  effectiveTo            DateTime?
  supersedesId           String?
  createdByPersonId      String
  createdAt              DateTime @default(now())

  @@index([systemId])
  @@index([configVersionId])
}
