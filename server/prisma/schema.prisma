// ADEPR Kacyiru — core identity, systems, participation, org-private finance.
// Ministry-specific tables (choir repertoire, protocol teams, …) come later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id              String   @id
  /// Church-wide member code M-00123: issued once from a counter, never reused, never changed.
  memberCode      String?  @unique
  /// Archived people keep their code and history but leave the directory and cannot sign in.
  archivedAt      DateTime?
  archivedReason  String?
  fullName        String
  preferredName   String?
  phone           String?
  email           String?
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE | VISITOR
  // Identity details — visible only to FULL viewers (Church Leader) and the person themself.
  dateOfBirth     String?  // YYYY-MM-DD
  gender          String?
  address         String?
  nationalId      String?
  joinedChurchOn  String?  // YYYY-MM-DD
  pastoralNotes   String?
  photoUrl        String?  // small thumbnail data URL only (<= ~30 KB)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account         Account?
  memberships     Membership[]
  positions       Position[]
  fundGrants      FundAccessGrant[] @relation("GrantHolder")
  fundGrantsIssued FundAccessGrant[] @relation("GrantIssuer")
  auditEvents     AuditEvent[]
}

model Account {
  id           String   @id
  personId     String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

/// Deployable peer / main / shared system in the ecosystem.
model ChurchSystem {
  id          String  @id // sys-main, sys-choir, …
  code        String  @unique
  name        String
  shortName   String
  kind        String // MAIN | MINISTRY | SHARED
  status      String  @default("ACTIVE") // ACTIVE | PLANNED
  description String  @default("")
  basePath    String
  externalUrl String?
  orgUnitId   String?

  orgUnit     OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  memberships Membership[]
  positions   Position[]
  funds       Fund[]
}

model OrgUnit {
  id             String  @id
  /// Unit code like KAC-MUS-IJWI: set once, never changes when the unit moves.
  code           String? @unique
  /// CENTRAL | MINISTRY | ORGANISATION | TEAM (the older `type` column stays for the old app).
  kind           String?
  name           String
  type           String // MINISTRY | TEAM | ORGANISATION | OFFICE | COMMITTEE
  parentId       String?
  description    String?
  systemId       String? // owning system when ministry-scoped
  leaderPersonId String?

  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgTree")
  systems  ChurchSystem[]
  memberships Membership[]
  positions   Position[]
  funds       Fund[]
}

model Membership {
  id        String    @id @default(cuid())
  personId  String
  systemId  String? // when set, active membership entitles entry to this system
  orgUnitId String?
  type      String // CHURCH_MEMBER | CHOIR_MEMBER | …
  label     String?
  status    String    @default("ACTIVE")
  startDate DateTime  @default(now())
  endDate   DateTime?

  person  Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  system  ChurchSystem? @relation(fields: [systemId], references: [id])
  orgUnit OrgUnit?     @relation(fields: [orgUnitId], references: [id])

  @@index([personId, systemId])
}

model Position {
  id             String    @id @default(cuid())
  personId       String
  systemId       String?
  orgUnitId      String?
  title          String
  /// The one office record (see OFFICE_CODES); the older office columns stay for the old app.
  office         String?
  systemRole     String? // CHURCH_LEADER | CHURCH_TREASURER | …
  ministryOffice String? // PRESIDENT | VP | TREASURER | SECRETARY
  choirOffice    String?
  choirAdvisorRole String?
  systemAdmin    Boolean   @default(false)
  worshipOffice  String?
  protocolOffice String?
  deaconOffice   String?
  grantsAllSystems Boolean @default(false)
  status         String    @default("ACTIVE")
  startDate      DateTime  @default(now())
  endDate        DateTime?

  person  Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  system  ChurchSystem? @relation(fields: [systemId], references: [id])
  orgUnit OrgUnit?      @relation(fields: [orgUnitId], references: [id])

  @@index([personId, systemId])
}

model Fund {
  id            String   @id
  name          String
  code          String   @unique
  kind          String // GENERAL | MINISTRY | EVENT | PROJECT
  orgUnitId     String
  ownerSystemId String?
  currency      String   @default("RWF")
  status        String   @default("ACTIVE")
  description   String?
  createdAt     DateTime @default(now())

  orgUnit OrgUnit       @relation(fields: [orgUnitId], references: [id])
  system  ChurchSystem? @relation(fields: [ownerSystemId], references: [id])
  grants  FundAccessGrant[]
  txns    FinanceTxn[]
}

/// ORG_PRIVATE vault ACL — never inferred from CHURCH_LEADER alone.
model FundAccessGrant {
  id                String    @id @default(cuid())
  fundId            String
  personId          String
  action            String // VIEW | MANAGE | APPROVE
  grantedByPersonId String
  reason            String
  status            String    @default("ACTIVE")
  startDate         DateTime  @default(now())
  endDate           DateTime?

  fund      Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  person    Person @relation("GrantHolder", fields: [personId], references: [id], onDelete: Cascade)
  grantedBy Person @relation("GrantIssuer", fields: [grantedByPersonId], references: [id])

  @@index([personId, fundId])
}

model FinanceTxn {
  id          String   @id @default(cuid())
  fundId      String
  kind        String // INCOME | EXPENSE
  amount      Int
  occurredOn  DateTime
  label       String
  note        String?
  postedById  String?
  createdAt   DateTime @default(now())

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId, occurredOn])
}

model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  systemId   String?
  action     String
  resource   String?
  detail     String?
  metaJson   String?

  actor Person? @relation(fields: [actorId], references: [id])

  @@index([at])
}

/// One-time SSO handoff tokens (church → peer).
model SsoHandoffToken {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  systemId  String
  expiresAt DateTime
  redeemedAt DateTime?
  createdAt DateTime @default(now())

  @@index([token])
}

/* ─── Mission kit (programs / events / tasks / projects) ─── */

model Program {
  id                String   @id @default(cuid())
  name              String
  description       String   @default("")
  orgUnitId         String?
  ownerSystemId     String
  visibility        String   @default("MINISTRY") // maps client: CHURCH|MINISTRY_PRIVATE|SELECTIVE
  /// Client-aligned: DRAFT | PENDING_APPROVAL | SETUP | ACTIVE | PAUSED | CLOSING | ENDED
  status            String   @default("DRAFT")
  programType       String?
  scheduleHint      String?
  parentProgramId   String?
  cohortLabel       String?
  createdByPersonId String?
  approvedByPersonId String?
  approvedAt        DateTime?
  /// JSON stewardship blob (money/delivery/ops). Versioned via stewardshipVersion.
  stewardshipJson   String?
  stewardshipVersion Int     @default(1)
  /// JSON: roles, eligibility, leaderPersonIds
  metaJson          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities        ProgramActivity[]
  enrollments       ProgramEnrollment[]

  @@index([ownerSystemId, status])
}

model ProgramActivity {
  id              String    @id @default(cuid())
  programId       String
  title           String
  startsAt        DateTime
  endsAt          DateTime?
  location        String?
  sessionClosedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  program     Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  attendances ActivityAttendance[]

  @@index([programId, startsAt])
}

model ProgramEnrollment {
  id        String    @id @default(cuid())
  programId String
  personId  String
  role      String    @default("PARTICIPANT") // LEADER | PARTICIPANT
  roleKey   String?
  status    String    @default("ACTIVE") // ACTIVE | COMPLETED | WITHDRAWN | ENDED
  enrolledOn DateTime @default(now())
  endedOn   DateTime?
  completedOn DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, personId])
  @@index([personId, status])
}

model ActivityAttendance {
  id         String   @id @default(cuid())
  activityId String
  personId   String
  status     String   // PRESENT | ABSENT | LATE | EXCUSED
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity ProgramActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, personId])
  @@index([personId])
}

model ChurchEvent {
  id                   String   @id @default(cuid())
  name                 String
  type                 String   @default("OTHER")
  description          String?
  orgUnitId            String?
  ownerSystemId        String
  visibility           String   @default("MINISTRY")
  startsAt             DateTime
  endsAt               DateTime?
  location             String?
  status               String   @default("DRAFT")
  registrationMode     String?
  capacity             Int?
  beyondOwnerScope     Boolean  @default(false)
  createdByPersonId    String?
  programId            String?
  projectId            String?
  collaboratorSystemIds String? // JSON array
  collaboratorPersonIds String? // JSON array
  lifecyclePhase       String?  @default("PREPARE")
  /// JSON array of EventApprovalRecord
  approvalsJson        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  registrations EventRegistration[]

  @@index([ownerSystemId, startsAt])
  @@index([projectId])
}

model EventRegistration {
  id           String    @id @default(cuid())
  eventId      String
  personId     String
  status       String    @default("REGISTERED") // REGISTERED | WAITLIST | CANCELLED | ATTENDED | NO_SHOW
  registeredOn DateTime  @default(now())
  attendedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event ChurchEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([personId, status])
}

model MissionShare {
  id                String    @id @default(cuid())
  kind              String    // PROGRAM | EVENT | TASK | PROJECT
  resourceId        String
  personId          String
  action            String    @default("VIEW") // VIEW | MANAGE
  grantedByPersonId String
  reason            String?
  status            String    @default("ACTIVE") // ACTIVE | REVOKED
  startDate         DateTime  @default(now())
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([kind, resourceId, status])
  @@index([personId, status])
}

model WorkTask {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  ownerPersonId      String
  helperPersonIds    String? // JSON array
  createdByPersonId  String?
  contextType        String    @default("GENERAL")
  contextId          String?
  contextLabel       String?
  systemId           String?
  grantsSystemAccess Boolean   @default(false)
  accessRevokedAt    DateTime?
  visibility         String    @default("MINISTRY")
  status             String    @default("TODO") // TODO | IN_PROGRESS | DONE | CANCELLED
  dueDate            DateTime?
  startDate          DateTime  @default(now())
  endDate            DateTime?
  outcomeNote        String?
  /// Slice 3.2: the unit that owns the work, and a soft delete only an Administrator can undo.
  orgUnitId          String?
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ownerPersonId, status])
  @@index([systemId, status])
}

model ChurchProject {
  id                String    @id @default(cuid())
  name              String
  description       String    @default("")
  ownerSystemId     String
  orgUnitId         String?
  visibility        String    @default("MINISTRY")
  /// Client-aligned: DRAFT | PENDING_APPROVAL | PLANNED | ACTIVE | PAUSED | CLOSING | DONE | CANCELLED
  status            String    @default("DRAFT")
  programId         String?
  fundId            String?
  willSpend         Boolean   @default(false)
  beyondOwnerScope  Boolean   @default(false)
  createdByPersonId String?
  leadPersonId      String?
  startsOn          DateTime?
  endsOn            DateTime?
  stewardshipJson   String?
  stewardshipVersion Int      @default(1)
  /// JSON array of scope approval records
  approvalsJson     String?
  collaboratorSystemIds String? // JSON array
  collaboratorPersonIds String? // JSON array
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerSystemId, status])
  @@index([programId])
}

/* ─── Temporary context roles (program / project / event) ─── */

model Assignment {
  id           String    @id @default(cuid())
  personId     String
  title        String
  contextType  String // PROGRAM | PROJECT | EVENT
  contextId    String
  contextLabel String
  orgUnitId    String?
  systemId     String? // temporary SYSTEM ENTER while active
  status       String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  startDate    DateTime  @default(now())
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([personId, status])
  @@index([systemId, status])
}

/* ─── Ministry contribution claims → FinanceTxn ─── */

/// Member claim; treasurer verify posts INCOME FinanceTxn into org-private fund.
model ContributionClaim {
  id                 String    @id @default(cuid())
  systemId           String
  fundId             String
  orgUnitId          String?
  personId           String
  typeLabel          String
  amount             Int
  paymentMethod      String
  occurredOn         DateTime
  note               String?
  status             String    @default("PENDING") // PENDING | CONFIRMED | PARTIAL | DECLINED
  confirmedAmount    Int?
  submittedAt        DateTime  @default(now())
  verifiedAt         DateTime?
  verifiedByPersonId String?
  verifyNote         String?
  financeTxnId       String?

  @@index([systemId, status])
  @@index([personId, submittedAt])
  @@index([fundId])
  @@index([orgUnitId])
}

/// Whole-document store for the church modules that still keep their state as
/// one JSON document per module (Music scheduling, Protocol). One row per
/// module key; `version` increases on every save and is used to detect
/// concurrent edits. This is a stepping stone to normalised tables.
model ScheduleDocument {
  key                String   @id // 'music' | 'protocol'
  data               String   // JSON
  version            Int      @default(1)
  updatedAt          DateTime @updatedAt
  updatedByPersonId  String?
}

/// Recent previous versions of a ScheduleDocument, so a bad save can be undone.
model ScheduleDocumentRevision {
  id                 String   @id @default(cuid())
  key                String
  version            Int
  data               String   // JSON
  createdAt          DateTime @default(now())
  savedByPersonId    String?

  @@index([key, version])
}

/// Named counters (member codes). A counter only goes up, so a code is never handed out twice.
model Counter {
  key   String @id
  value Int    @default(0)
}

/// Slice 1.3: an office holder lends some of their letters to someone else for a short time.
/// It lives only while the lender still holds the office; ending the office ends it at once.
model Delegation {
  id           String    @id @default(cuid())
  positionId   String
  fromPersonId String
  toPersonId   String
  /// {"MONEY":["R","W"]}: the letters lent, by module.
  lettersJson  String
  note         String?
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  startDate    DateTime  @default(now())
  endDate      DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  @@index([toPersonId, status])
  @@index([positionId])
}

/// Slice 1.4: a notice for a person, or for whoever holds an office. WAITING_FOR_ME needs the person
/// to act; FOR_INFORMATION only tells them. Read state is per person (NotificationRead).
model Notification {
  id         String   @id @default(cuid())
  kind       String // WAITING_FOR_ME | FOR_INFORMATION
  toPersonId String?
  /// An office code: every live holder of the office receives it.
  toOffice   String?
  /// Narrows an office address to the holders in one system.
  toSystemId String?
  /// The system the notice belongs to; the main church when empty.
  systemId   String?
  title      String
  body       String?
  href       String?
  /// Stops the same event notifying the same person twice.
  sourceKey  String?
  /// Important notices ignore a person's muted systems.
  important  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([toPersonId, createdAt])
  @@index([toOffice, createdAt])
}

/// Which notifications (or attention items, keyed attn:<id>) a person has read.
model NotificationRead {
  id       String   @id @default(cuid())
  personId String
  key      String
  readAt   DateTime @default(now())

  @@unique([personId, key])
}

/// A person's preferences, kept on the server so they follow them to every device.
model Preference {
  personId          String   @id
  language          String?
  /// Systems whose "For information" notices the person has muted: ["sys-youth"].
  mutedSystemsJson  String   @default("[]")
  updatedAt         DateTime @updatedAt
}

/// An announcement (slice 1.5). Who sees it is worked out on read from its audience and the
/// letters engine, so nothing is copied per person and a leaver stops seeing it at once.
model Announcement {
  id               String    @id @default(cuid())
  title            String
  body             String
  /// WHOLE_CHURCH | SYSTEM (everyone with a place in one system) | OFFICE (every live holder of one office)
  audienceKind     String
  audienceSystemId String?
  audienceOffice   String?
  /// The system whose Send letter allowed the post (the main church for WHOLE_CHURCH and OFFICE).
  systemId         String
  authorId         String
  /// PUBLISHED | WITHDRAWN
  status           String    @default("PUBLISHED")
  publishedAt      DateTime  @default(now())
  /// Last day shown, inclusive; empty means until withdrawn.
  expiresAt        DateTime?
  withdrawnAt      DateTime?
  withdrawnById    String?
  withdrawnReason  String?

  @@index([publishedAt])
}

/// Central Administration's settings (slice 2.1): one row per setting that differs from its default.
model Setting {
  key         String   @id
  valueJson   String
  updatedAt   DateTime @default(now())
  updatedById String?
}

/// A meeting of one unit (slice 2.2); the Board is a Central Administration meeting of type BOARD.
model Meeting {
  id              String    @id @default(cuid())
  orgUnitId       String
  systemId        String
  /// A code from the meeting types setting.
  typeCode        String
  title           String
  scheduledAt     DateTime
  location        String?
  agenda          String?
  minutes         String?
  /// JSON array of person ids who attended, recorded when the meeting is marked held.
  attendeesJson   String    @default("[]")
  /// PLANNED | HELD | CANCELLED
  status          String    @default("PLANNED")
  createdById     String
  createdAt       DateTime  @default(now())
  heldAt          DateTime?
  heldById        String?
  cancelledReason String?

  @@index([systemId, scheduledAt])
}

/// A decision in the register (slice 2.2). A decision about work carries its owner and date and becomes a task when approved.
model Decision {
  id              String    @id @default(cuid())
  meetingId       String?
  orgUnitId       String
  systemId        String
  title           String
  detail          String?
  /// DRAFT | APPROVED | REJECTED | WITHDRAWN
  status          String    @default("DRAFT")
  createdById     String
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedById     String?
  rejectReason    String?
  withdrawnReason String?
  ownerPersonId   String?
  dueDate         DateTime?
  taskId          String?

  @@index([systemId, createdAt])
}

model Letter {
  id              String    @id @default(cuid())
  reference       String
  orgUnitId       String
  systemId        String
  typeCode        String
  subject         String
  body            String
  recipientName   String
  recipientNote   String?
  /// DRAFT | DELIVERED | WITHDRAWN
  status          String    @default("DRAFT")
  createdById     String
  createdAt       DateTime  @default(now())
  printedAt       DateTime?
  printedById     String?
  deliveredAt     DateTime?
  deliveredById   String?
  deliveryMethod  String?
  deliveredOn     DateTime?
  deliveryNote    String?
  withdrawnReason String?

  @@index([systemId, createdAt])
}

model MonthPlan {
  id            String    @id @default(cuid())
  orgUnitId     String
  systemId      String
  /// YYYY-MM in church time (Kigali, UTC+2)
  month         String
  /// DRAFT | CONFIRMED | PUBLISHED
  status        String    @default("DRAFT")
  createdById   String
  createdAt     DateTime  @default(now())
  confirmedById String?
  confirmedAt   DateTime?
  publishedById String?
  publishedAt   DateTime?

  @@index([systemId, month])
}

model ScheduleSlot {
  id          String    @id @default(cuid())
  planId      String
  orgUnitId   String
  systemId    String
  title       String
  /// SERVICE | REHEARSAL | MEETING | OTHER
  kind        String    @default("OTHER")
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  notes       String?
  churchWide  Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())

  @@index([planId])
  @@index([systemId, startsAt])
}

model SlotAssignment {
  id            String    @id @default(cuid())
  slotId        String
  personId      String
  role          String
  /// ASSIGNED | DECLINED
  status        String    @default("ASSIGNED")
  declineReason String?
  respondedAt   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  @@index([slotId])
  @@index([personId])
}

model WorkPlan {
  id                   String    @id @default(cuid())
  orgUnitId            String
  systemId             String
  title                String
  aim                  String    @default("")
  needs                String?
  location             String?
  startsOn             DateTime?
  endsOn               DateTime?
  leaderPersonId       String
  /// JSON array of { personId, role }
  teamJson             String    @default("[]")
  /// CHURCH wide reach adds a Church Leader approval on top of the unit's own
  beyondUnit           Boolean   @default(false)
  visibility           String    @default("SYSTEM")
  /// DRAFT | PENDING_APPROVAL | SETUP | RUNNING | CLOSING | ENDED | CANCELLED
  status               String    @default("DRAFT")
  /// JSON array of { levelKey, label, systemId, status, byId, at, note }
  approvalsJson        String    @default("[]")
  rejectedReason       String?
  cancelReason         String?
  planningSummary      String?
  executionSummary     String?
  outcome              String?
  reportComposedById   String?
  reportComposedAt     DateTime?
  reportPublishedById  String?
  reportPublishedAt    DateTime?
  /// The frozen report, written once when it is published
  reportJson           String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  deletedById          String?

  @@index([systemId, status])
  @@index([leaderPersonId])
}

model WorkPlanNote {
  id        String   @id @default(cuid())
  planId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([planId])
}

model WorkPlanCheck {
  id          String    @id @default(cuid())
  planId      String
  label       String
  done        Boolean   @default(false)
  doneById    String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([planId])
}

model MoneyAccount {
  id          String   @id @default(cuid())
  orgUnitId   String
  systemId    String
  name        String
  /// ACTIVE | CLOSED
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())

  @@index([systemId, status])
}

/// Money is never deleted. Income is recorded; spending waits for approval; either can be voided with a reason (spending only before it is approved).
model MoneyEntry {
  id           String    @id @default(cuid())
  accountId    String
  orgUnitId    String
  systemId     String
  /// INCOME | SPENDING
  kind         String
  /// Whole Rwandan francs
  amount       Int
  occurredOn   DateTime
  category     String
  note         String?
  /// RECORDED (income) | PENDING_APPROVAL | APPROVED | REJECTED (spending) | VOIDED
  status       String
  recordedById String
  recordedAt   DateTime  @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([accountId, status])
  @@index([systemId, occurredOn])
}

/// Offerings counted at a service. A count record only: it carries no link to any MoneyEntry,
/// because the treasurer records what was handed over in Money on their own.
model OfferingCount {
  id            String    @id @default(cuid())
  orgUnitId     String
  systemId      String
  serviceOn     DateTime
  label         String
  /// OFFERING | THANKSGIVING | SPECIAL
  kind          String    @default("OFFERING")
  amount        Int
  /// JSON array of person ids who counted
  countersJson  String    @default("[]")
  note          String?
  /// RECORDED | CONFIRMED | VOIDED
  status        String    @default("RECORDED")
  recordedById  String
  recordedAt    DateTime  @default(now())
  confirmedById String?
  confirmedAt   DateTime?
  handedToId    String?
  handedAt      DateTime?
  voidReason    String?

  @@index([systemId, serviceOn])
}

/// A report composed from live records, then frozen when it is published (slice 3.5).
model Report {
  id            String    @id @default(cuid())
  systemId      String
  orgUnitId     String
  /// MEETINGS | ATTENDANCE | MONEY | COLLECTIONS | PEOPLE_LIST | WORK_PLANS
  kind          String
  /// YYYY-MM (a month) or YYYY (a year)
  periodKey     String
  title         String
  /// DRAFT | PUBLISHED
  status        String    @default("DRAFT")
  /// The figures. Rewritten while DRAFT; never again once PUBLISHED.
  snapshotJson  String    @default("{}")
  composedById  String
  composedAt    DateTime  @default(now())
  publishedById String?
  publishedAt   DateTime?
  deletedAt     DateTime?
  deletedById   String?

  @@index([systemId, status])
  @@index([orgUnitId, kind, periodKey])
}

/// A report a unit owes every month, due on a day of the following month.
model ReportSchedule {
  id          String   @id @default(cuid())
  systemId    String
  orgUnitId   String
  kind        String
  /// Day of the following month (1-28)
  dueDay      Int
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@index([systemId, active])
}

/// Person 360: one history-keeping record per fact about a person (slice 3.6). Edits add a new record and
/// mark the old one SUPERSEDED; mistakes are VOIDED with a reason. Nothing is overwritten or deleted.
model PersonRecord {
  id           String    @id @default(cuid())
  personId     String
  /// CONTACT | EMPLOYMENT | EDUCATION | GIFT | SKILL | CALLING | FAMILY | BAPTISM | MARRIAGE
  section      String
  dataJson     String    @default("{}")
  /// CURRENT | SUPERSEDED | VOIDED
  status       String    @default("CURRENT")
  supersedesId String?
  /// A baptism recorded from a programme cohort carries the programme
  programId    String?
  recordedById String
  recordedAt   DateTime  @default(now())
  voidReason   String?
  voidedById   String?
  voidedAt     DateTime?

  @@index([personId, section, status])
  @@index([programId])
}

/// A fellowship group, Sunday School class or age group inside a unit (slice 3.8).
model UnitGroup {
  id             String   @id @default(cuid())
  orgUnitId      String
  systemId       String
  /// FELLOWSHIP | CLASS | AGE_GROUP
  kind           String
  name           String
  leaderPersonId String?
  ageFrom        Int?
  ageTo          Int?
  meetsOn        String?
  /// ACTIVE | CLOSED
  status         String   @default("ACTIVE")
  createdById    String
  createdAt      DateTime @default(now())

  @@index([systemId, status])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  personId  String
  joinedOn  DateTime  @default(now())
  leftOn    DateTime?
  /// ACTIVE | LEFT
  status    String    @default("ACTIVE")

  @@index([groupId, status])
  @@index([personId])
}

/// One meeting of a group with who was present.
model GroupSession {
  id           String   @id @default(cuid())
  groupId      String
  heldOn       DateTime
  /// JSON array of person ids who were present
  presentJson  String   @default("[]")
  note         String?
  recordedById String
  recordedAt   DateTime @default(now())

  @@index([groupId, heldOn])
}

/// Two people shown as a pair in the Couples ministry.
model CouplePair {
  id          String    @id @default(cuid())
  systemId    String
  personAId   String
  personBId   String
  marriedOn   DateTime?
  /// ACTIVE | ENDED
  status      String    @default("ACTIVE")
  createdById String
  createdAt   DateTime  @default(now())

  @@index([systemId, status])
}

/// A visit to an elderly person; private to those who may change People records in Elderly.
model VisitLog {
  id            String   @id @default(cuid())
  systemId      String
  elderPersonId String
  visitedOn     DateTime
  /// JSON array of visitor person ids
  visitorsJson  String   @default("[]")
  note          String?
  recordedById  String
  recordedAt    DateTime @default(now())

  @@index([systemId, visitedOn])
  @@index([elderPersonId])
}

/// A weekly prayer watch of the Intercessors.
model PrayerWatch {
  id          String   @id @default(cuid())
  systemId    String
  name        String
  /// 0 = Sunday … 6 = Saturday
  weekday     Int
  startTime   String
  endTime     String
  /// ACTIVE | CLOSED
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())

  @@index([systemId, status])
}

model PrayerWatchMember {
  id       String @id @default(cuid())
  watchId  String
  personId String
  /// ACTIVE | LEFT
  status   String @default("ACTIVE")

  @@index([watchId, status])
}

/// A person met through evangelism, followed up until they join or the contact is closed.
model EvangelismContact {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  howMet       String?
  metOn        DateTime @default(now())
  assignedToId String?
  /// NEW | FOLLOWING | JOINED | CLOSED
  status       String   @default("NEW")
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([status])
}

model ContactFollowUp {
  id           String    @id @default(cuid())
  contactId    String
  doneOn       DateTime
  note         String
  nextOn       DateTime?
  recordedById String
  recordedAt   DateTime  @default(now())

  @@index([contactId])
}

model GuestPreacher {
  id          String   @id @default(cuid())
  name        String
  church      String?
  phone       String?
  note        String?
  /// ACTIVE | ARCHIVED
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())
}

/// One service in the preaching plan: a member or a guest preaches.
model PulpitSlot {
  id               String   @id @default(cuid())
  serviceOn        DateTime
  preacherPersonId String?
  guestId          String?
  theme            String?
  bibleText        String?
  /// PLANNED | DONE | CANCELLED
  status           String   @default("PLANNED")
  createdById      String
  createdAt        DateTime @default(now())

  @@index([serviceOn])
}

/// A choir or worship team of the Music ministry (the register of who sings is MusicChoirMember).
model MusicChoir {
  id          String   @id @default(cuid())
  name        String
  /// PRIMARY | SECONDARY | CHILDREN | WORSHIP
  role        String
  /// The choir's own system (sys-choir or sys-worship), whose leaders may manage its register
  systemId    String?
  orgUnitId   String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
}

model MusicChoirMember {
  id       String   @id @default(cuid())
  choirId  String
  personId String
  /// ACTIVE | LEFT
  status   String   @default("ACTIVE")
  joinedOn DateTime @default(now())

  @@index([choirId, status])
  @@index([personId])
}

/// The month plan: one per month, DRAFT until published.
model MusicPlan {
  id          String    @id @default(cuid())
  /// YYYY-MM
  periodKey   String    @unique
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
}

model MusicService {
  id        String   @id @default(cuid())
  planId    String
  serviceOn DateTime
  /// SS1 | SS2 | TUESDAY | FRIDAY | IGABURO
  kind      String
  label     String?
  /// ACTIVE | REMOVED
  status    String   @default("ACTIVE")

  @@index([planId])
}

model MusicAssignment {
  id        String @id @default(cuid())
  serviceId String
  choirId   String
  /// ACTIVE | REMOVED
  status    String @default("ACTIVE")

  @@index([serviceId])
}

/// One rehearsal of a choir with who came.
model ChoirRehearsal {
  id           String   @id @default(cuid())
  choirId      String
  heldOn       DateTime
  /// JSON array of person ids who were present
  presentJson  String   @default("[]")
  note         String?
  recordedById String
  recordedAt   DateTime @default(now())

  @@index([choirId, heldOn])
}

model ChoirSong {
  id          String    @id @default(cuid())
  choirId     String
  title       String
  composer    String?
  songKey     String?
  lastSungOn  DateTime?
  /// ACTIVE | RETIRED
  status      String    @default("ACTIVE")
  createdById String
  createdAt   DateTime  @default(now())

  @@index([choirId])
}

/// A sponsor of a choir. Pledges here are kept apart from Money, like Collections.
model ChoirSponsor {
  id          String   @id @default(cuid())
  choirId     String
  name        String
  /// PERSON | ORGANISATION
  kind        String   @default("PERSON")
  contact     String?
  /// ACTIVE | ENDED
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())

  @@index([choirId])
}

model SponsorPledge {
  id           String    @id @default(cuid())
  sponsorId    String
  amount       Int
  pledgedOn    DateTime
  receivedOn   DateTime?
  note         String?
  /// PLEDGED | RECEIVED | CANCELLED
  status       String    @default("PLEDGED")
  recordedById String
  recordedAt   DateTime  @default(now())

  @@index([sponsorId])
}
