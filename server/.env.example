# Server (local SQLite — keep this for day-to-day work)
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me-in-production"
CORS_ORIGIN="http://localhost:5173"

# Production uses Neon + schema.postgres.prisma — see ../DEPLOY.md and .env.production.example

# Create the demo role accounts (music, protocol, protocolpres, ...) on the server so
# they can share Music/Protocol data across browsers. Never on a real deployment.
SEED_DEMO_ACCOUNTS=true

# Role checks on shared Music/Protocol saves: off | warn (default) | enforce.
# Use enforce once real office holders exist as server Positions.
SCHEDULE_GUARD=warn
# Hide unpublished Music drafts and other people's notifications/contributions on read.
# off (default; the demo role logins have no grants and need to share everything) | on (real launch)
SCHEDULE_READ_FILTER=off

# On a real deployment (NODE_ENV=production) the pastor / treasurer sign-ins are
# created only if you set these (10+ characters). Locally they default to pastor123 / treas123.
# BOOTSTRAP_PASTOR_PASSWORD=
# BOOTSTRAP_TREASURER_PASSWORD=
# The built-in demo choirs are created locally; set true to create them in production too.
# SEED_DEFAULT_CHOIRS=true
