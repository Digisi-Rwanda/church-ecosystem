{
  "name": "@kacyiru/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:generate:pg": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgres.prisma",
    "db:seed:pg": "tsx prisma/seed.ts",
    "setup:pg": "npm run db:generate:pg && npm run db:push:pg && npm run db:seed:pg",
    "build:render": "npm run db:generate:pg && npm run build",
    "start:render": "npm run db:push:pg && npm run db:seed:pg && npm start",
    "test:policy": "tsx scripts/policy-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
