};
const choices = {
  MALE:'Gabo', FEMALE:'Gore', EMPLOYED:'Mfite umukoresha', SELF_EMPLOYED:'Ndikorera',
  STUDENT:'Ndi umunyeshuri', UNEMPLOYED:'Ndashaka akazi', RETIRED:'Ndi mu kiruhuko cy’izabukuru',
  FINANCE:'Imari', EDUCATION:'Uburezi', HEALTH:'Ubuzima', AGRICULTURE:'Ubuhinzi', TECHNOLOGY:'Ikoranabuhanga', BUSINESS:'Ubucuruzi', CONSTRUCTION:'Ubwubatsi', TRANSPORT:'Ubwikorezi', GOVERNMENT:'Leta', CHURCH:'Itorero', OTHER:'Ibindi',
  NONE:'Nta mashuri', PRIMARY:'Amashuri abanza', SECONDARY:'Amashuri yisumbuye', SECONDARY_O:'Icyiciro rusange cy’amashuri yisumbuye', SECONDARY_A:'Icyiciro cya kabiri cy’amashuri yisumbuye', ASSOCIATE:'Amashuri makuru y’imyuga', VOCATIONAL:'Amashuri y’imyuga', DIPLOMA:'Impamyabumenyi', BACHELOR:'Icyiciro cya mbere cya kaminuza', MASTER:'Icyiciro cya kabiri cya kaminuza', DOCTORATE:'Impamyabumenyi y’ikirenga',
};
function workFields(status,sector) {
  if(status==='RETIRED')return ['since'];
  return status==='EMPLOYED'?['sector','employer','role','since',...(sector==='BUSINESS'?['business']:[])]:status==='SELF_EMPLOYED'?['sector','since',...(sector==='BUSINESS'?['business']:[])]:[];
}
function workQuestion(key,status){
  if(status!=='RETIRED')return T['EMPLOYMENT.'+key];
  return ({since:['Since when have you been retired?','Wagiye mu kiruhuko cy’izabukuru ryari?'],sector:['In which field did you work?','Wakoraga mu ruhe rwego?'],employer:['Which organisation employed you?','Ni ikihe kigo cyagukoresheje?'],business:['What business did you run?','Wakoraga ubuhe bucuruzi?'],role:['What was your job title/role?','Wari ushinzwe iki mu kazi?']})[key];
}
function educationFields(level,studying) {
  if(!level||level==='NONE')return [];
  return [...(!['PRIMARY'].includes(level)?['school']:[]),...(!['PRIMARY','SECONDARY_O'].includes(level)?['field']:[]),'startYear',...(studying==='NO'?['endYear']:[])];
}
function dateValue(value) {
  const match=/^(\d{2})-(\d{2})-(\d{4})$/.exec(value);
  if(!match)throw new Error('Use DD-MM-YYYY / Koresha DD-MM-YYYY.');
  const iso=`${match[3]}-${match[2]}-${match[1]}`, date=new Date(iso+'T00:00:00Z');
  if(!Number.isFinite(date.getTime())||date.toISOString().slice(0,10)!==iso)throw new Error('Enter a real date / Andika itariki ibaho.');
  return iso;
}
function registrationRow(schema, answers, members) {
  const row={};
  for(const col of schema.columns) {
    if(col.section==='MARRIAGE')continue;
    const work=workFields(answers['EMPLOYMENT.status'],answers['EMPLOYMENT.sector']);
    if(col.section==='EMPLOYMENT'&&col.key!=='EMPLOYMENT.status'&&!work.includes(col.key.split('.')[1]))continue;
    if(col.section==='BAPTISM'&&answers.baptised!=='YES')continue;
    if(col.section==='EDUCATION'&&col.key!=='EDUCATION.level'&&!educationFields(answers['EDUCATION.level'],answers.studying).includes(col.key.split('.')[1]))continue;
    if(col.key==='BAPTISM.place')continue;
    const required=col.section==='BASICS'&&!['phone','email','joinedChurchOn'].includes(col.key)
      ||col.key==='EMPLOYMENT.status'||col.section==='BAPTISM'||col.section==='EMPLOYMENT'&&work.length>0;
    let value=String(answers[col.key]||'').trim();
    if(!value){if(required)throw new Error((T[col.key]||[col.question]).join(' / '));continue;}
    if(col.max&&value.length>col.max)throw new Error('Answer too long / Igisubizo ni kirekire cyane.');
    if(col.choices&&!col.choices.some(c=>c.code===value))throw new Error('Choose an available answer / Hitamo igisubizo kiri ku rutonde.');
    if(col.type==='date')value=dateValue(value);
    if(col.type==='number'&&(!/^\d{4}$/.test(value)||+value<1930||+value>2100))throw new Error('Enter a valid year / Andika umwaka ukwiye.');
    row[col.header]=value;
  }
  for(const key of ['married','hasChildren','baptised'])if(!['YES','NO'].includes(answers[key]))throw new Error('Answer Yes or No / Subiza Yego cyangwa Oya.');
  const contacts=[];
  // The current importer strips these fields for these work statuses.
  if(answers['EMPLOYMENT.status']==='EMPLOYED'&&row['Work - Business']){
    contacts.push({label:'Work - Business and trade activity',value:row['Work - Business']});delete row['Work - Business'];
  }
  if(answers['EDUCATION.level']&&answers['EDUCATION.level']!=='NONE'){
    if(!['YES','NO'].includes(answers.studying))throw new Error('Are you still studying? / Uracyiga?');
    contacts.push({label:'Education - Still studying',value:answers.studying==='YES'?'Yes':'No'});
  }
  if(row['Education - Start year']&&row['Education - End year']&&+row['Education - End year']<+row['Education - Start year'])throw new Error('Check education years / Reba imyaka y’amashuri.');
  if(answers.baptised==='YES'){
    if(!['ADEPR','OTHER'].includes(answers.baptismChurch))throw new Error('Choose baptism church / Hitamo aho wabatirijwe.');
    if(answers.baptismChurch==='ADEPR'){
      if(!['KACYIRU','OTHER'].includes(answers.adeprCongregation))throw new Error('Choose the ADEPR congregation / Hitamo umudugudu wa ADEPR.');
      if(answers.adeprCongregation==='KACYIRU')row['Baptism - Place']='ADEPR Kacyiru';
      else{
        const name=String(answers.otherAdepr||'').trim();
        if(!name||name.length>110)throw new Error('Name the ADEPR congregation / Andika izina ry’umudugudu wa ADEPR.');
        if(!['YES','NO'].includes(answers.broughtRecommendation))throw new Error('Did you bring a recommendation letter? / Wazanye icyemezo cy’icyimuko?');
        row['Baptism - Place']='ADEPR '+name;
        contacts.push({label:'Baptism - Recommendation letter brought',value:answers.broughtRecommendation==='YES'?'Yes':'No'});
      }
    }
    else{
      const name=String(answers.otherChurch||'').trim();
      if(!name||name.length>120)throw new Error('Name the church / Andika izina ry’itorero.');
      if(!['YES','NO'].includes(answers.receivedInAdepr))throw new Error('Have you been officially received in ADEPR? / Warakiriwe muri ADEPR?');
      row['Baptism - Place']=name;
      contacts.push({label:'Baptism - Officially received in ADEPR',value:answers.receivedInAdepr==='YES'?'Yes':'No'});
    }
  }
  row.CONTACT=contacts.length?JSON.stringify(contacts):'';
  const family=[];
  function member(relation, value, gender) {
    const name=String(value.name||'').trim();
    if(!name||name.length>120)throw new Error('Enter the family member’s full name / Andika amazina yose y’uwo mu muryango.');
    const item={relation,name,...(gender?{gender}:{})};
    for(const key of ['phone','nationalId']){const val=String(value[key]||'').trim();if(val.length>30)throw new Error('Phone / ID: maximum 30 characters.');if(val)item[key]=val;}
    family.push(item);
  }
  member('PARENT',members.father||{},'MALE');member('PARENT',members.mother||{},'FEMALE');
  for(const sibling of members.siblings||[])member('SIBLING',sibling);
  if(answers.married==='YES'){
    for(const key of ['spousePhone','spouseNationalId'])if(!String(answers[key]||'').trim())throw new Error('Spouse phone and National ID are required / Telefone n’indangamuntu by’uwo mwashakanye birakenewe.');
    member('SPOUSE',{name:answers.spouseName,phone:answers.spousePhone,nationalId:answers.spouseNationalId});
  }
  if(answers.hasChildren==='YES') {
    if(!members.children?.length)throw new Error('Add a child / Ongeraho umwana.');
    for(const child of members.children)member('CHILD',child);
  }
  row.FAMILY=JSON.stringify(family);
  const roles=[...new Set(answers.callings||[])];
  if(roles.some(name=>!String(name).trim()||name.length>80))throw new Error('Check serving roles / Reba imirimo ukora mu itorero.');
  const choir=roles.includes('Singer')?schema.choirs.find(choir=>choir.id===answers.choir):null;
  if(roles.includes('Singer')&&!choir)throw new Error('Choose your choir / Hitamo korali yawe.');
  row.CALLING=roles.length?JSON.stringify(roles.map(name=>({name,...(name==='Singer'?{note:'Choir / Korali: '+choir.name}:{})}))):'';
  return row;
}
function csv(schema,row) {
  // Keep all collected answers on the page rather than exporting a known-invalid import.
  const records=['CALLING','FAMILY','CONTACT'].reduce((sum,key)=>sum+(row[key]?JSON.parse(row[key]).length:0),0)
    +['EMPLOYMENT','EDUCATION','BAPTISM'].filter(section=>schema.columns.some(c=>c.section===section&&row[c.header])).length;
  if(records>50)throw new Error('Your answers are still on this page. This profile exceeds the current import limit of 50 records; ask the administrator before importing. / Ibisubizo biracyari kuri iyi paji. Aya makuru arenze urugero rwa 50 rwemewe mu kwinjiza amakuru; banza ubaze umuyobozi.');
  const quote=value=>'"'+String(value??'').replace(/"/g,'""')+'"';
  return '\uFEFF'+[schema.headers,schema.headers.map(key=>row[key]||'')].map(line=>line.map(quote).join(',')).join('\r\n')+'\r\n';
}

// Closure-scoped: no collisions with existing saved collections.
const STORE='MORIAH_CHURCH_WIDE:'+SPEC.version;
function save(state){const data=JSON.stringify(state),props=PropertiesService.getScriptProperties();for(let i=0;i<data.length;i+=7000)props.setProperty(STORE+':'+(i/7000),data.slice(i,i+7000));props.setProperty(STORE,String(Math.ceil(data.length/7000)));}
function load(){const props=PropertiesService.getScriptProperties(),count=Number(props.getProperty(STORE)||0);if(!count)return null;let data='';for(let i=0;i<count;i++)data+=props.getProperty(STORE+':'+i);return JSON.parse(data);}
function create(){
 const lock=LockService.getScriptLock();lock.waitLock(30000);
 try{
  const prior=load();if(prior){if(prior.state!=='READY')throw Error('An unfinished new collection already exists. Inspect it; do not create another.');console.log('CHURCH_CREATED '+JSON.stringify(prior));return;}
  const form=FormApp.create(SPEC.title,false);
  const state={state:'CREATING',version:SPEC.version,formId:form.getId(),items:{},pages:{},editUrl:form.getEditUrl()};save(state);
  form.setTitle(SPEC.title).setDescription('English / Ikinyarwanda. Dates / Amatariki: DD-MM-YYYY.\nEach response can include up to 20 siblings and 20 children. / Igisubizo kimwe gishobora kugira abavandimwe 20 n’abana 20.').setCollectEmail(false).setPublishingSummary(false).setProgressBar(true).setShuffleQuestions(false);
  const pages={},items={};
  SPEC.nodes.forEach(function(n,index){
   if(index===0)form.addSectionHeaderItem().setTitle(n.title);else{pages[n.id]=form.addPageBreakItem().setTitle(n.title);state.pages[n.id]=String(pages[n.id].getId());}
   n.questions.forEach(function(q){
    const item=q.type==='branch'?form.addMultipleChoiceItem():q.type==='checkbox'?form.addCheckboxItem():q.options?form.addListItem():form.addTextItem();
    item.setTitle(q.title).setRequired(q.required);items[n.id+':'+q.key]=item;
    state.items[String(item.getId())]={key:q.key,node:n.id,type:q.type,options:q.options||null};
    if(q.options)item.setChoiceValues(q.options.map(function(o){return o.label;}));
    if(q.type==='checkbox')item.showOtherOption(true);
    if(!q.options){
     const v=FormApp.createTextValidation();
     if(q.type==='date'){v.requireTextMatchesPattern('^\\d{2}-\\d{2}-\\d{4}$');item.setHelpText('DD-MM-YYYY');}
     else if(q.type==='email')v.requireTextIsEmail();
     else if(q.type==='number')v.requireTextMatchesPattern('^(19[3-9][0-9]|20[0-9]{2}|2100)$');
     else v.requireTextLengthLessThanOrEqualTo(q.max||200);
     item.setValidation(v.build());
    }
   });
   state.lastCompletedNode=n.id;save(state);
  });
  // Google stores a section's default exit on the FOLLOWING physical page break.
  SPEC.nodes.forEach(function(n,index){
   if(n.next&&index+1<SPEC.nodes.length)pages[SPEC.nodes[index+1].id].setGoToPage(pages[n.next]);
   n.questions.filter(function(q){return q.type==='branch';}).forEach(function(q){const item=items[n.id+':'+q.key];item.setChoices(q.options.map(function(o){return item.createChoice(o.label,pages[o.go]);}));});
  });
  const sheet=SpreadsheetApp.create('Church — Person 360 responses / Itorero — Ibisubizo');form.setDestination(FormApp.DestinationType.SPREADSHEET,sheet.getId());
  Object.assign(state,{state:'READY',sheetId:sheet.getId(),sheetUrl:sheet.getUrl(),responderUrl:form.getPublishedUrl(),createdAt:new Date().toISOString()});save(state);
  console.log('CHURCH_CREATED '+JSON.stringify({state:state.state,version:state.version,formId:state.formId,editUrl:state.editUrl,sheetId:state.sheetId,sheetUrl:state.sheetUrl,responderUrl:state.responderUrl}));
 }finally{lock.releaseLock();}
}
function verify(){
 const state=load();if(!state||state.state!=='READY')throw Error('New church collection not ready.');
 const form=FormApp.openById(state.formId),all=form.getItems(),byId={};all.forEach(function(item){byId[String(item.getId())]=item;});
 let questionCount=0,branchCount=0;
 SPEC.nodes.forEach(function(n,index){
  if(index>0&&byId[state.pages[n.id]].getTitle()!==n.title)throw Error('Section mismatch: '+n.id);
  n.questions.forEach(function(q){
   const id=Object.keys(state.items).find(function(id){return state.items[id].node===n.id&&state.items[id].key===q.key;});
   const base=byId[id];if(!base||base.getTitle()!==q.title)throw Error('Question mismatch: '+q.key);
   const item=q.type==='branch'?base.asMultipleChoiceItem():q.type==='checkbox'?base.asCheckboxItem():q.options?base.asListItem():base.asTextItem();
   if(item.isRequired()!==q.required)throw Error('Required mismatch: '+q.key);
   if(q.options){const actual=item.getChoices();if(actual.length!==q.options.length||actual.some(function(c,i){return c.getValue()!==q.options[i].label;}))throw Error('Choices mismatch: '+q.key);}
   if(q.type==='branch'){branchCount++;item.getChoices().forEach(function(c,i){if(String(c.getGotoPage().getId())!==state.pages[q.options[i].go])throw Error('Branch mismatch: '+q.key);});}
   questionCount++;
  });
  if(n.next&&index+1<SPEC.nodes.length){const destination=byId[state.pages[SPEC.nodes[index+1].id]].asPageBreakItem().getGoToPage();if(!destination||String(destination.getId())!==state.pages[n.next])throw Error('Default exit mismatch: '+n.id);}
 });
 if(all.length!==questionCount+SPEC.nodes.length)throw Error('Unexpected item count.');
 if(form.isPublished()||form.getDestinationId()!==state.sheetId||form.getResponses().length!==0)throw Error('Publication, destination or response check failed.');
 const report={verifiedAt:new Date().toISOString(),formId:state.formId,version:state.version,title:form.getTitle(),published:form.isPublished(),responses:0,questions:questionCount,sections:SPEC.nodes.length,branches:branchCount,siblingLimit:20,childLimit:20,requiredAndChoicesVerified:true,navigationVerified:true,existingCollectionsAccessed:false,editUrl:form.getEditUrl(),responderUrl:state.responderUrl,sheetUrl:state.sheetUrl};
 console.log('CHURCH_VERIFIED '+JSON.stringify(report));
}
function responseRow(response,state){
 const byNode={};response.getItemResponses().forEach(function(r){const meta=state.items[String(r.getItem().getId())];if(!meta)return;const raw=r.getResponse();const decode=function(value){const option=(meta.options||[]).find(function(o){return o.label===value;});return option?option.code:value;};const value=Array.isArray(raw)?raw.map(decode):decode(raw);if(value!==''&&value!=null){if(!byNode[meta.node])byNode[meta.node]={};byNode[meta.node][meta.key]=value;}});
 // Only export the current route, excluding stale answers left after navigating Back.
 const answers={},visited={};let id='about';
 while(id){if(visited[id])throw Error('Questionnaire route cycle.');visited[id]=true;const n=SPEC.nodes.find(function(n){return n.id===id;});if(!n)throw Error('Unknown questionnaire route.');const current=byNode[id]||{};Object.assign(answers,current);const branch=n.questions.find(function(q){return q.type==='branch';});if(branch){const option=branch.options.find(function(o){return o.code===current[branch.key];});if(!option)throw Error('Missing routing answer: '+branch.title);id=option.go;}else id=n.next;}
 answers.callings=answers.callings||[];if(answers.singer==='YES')answers.callings.push('Singer');
 function member(prefix){return {name:answers[prefix+'.name'],phone:answers[prefix+'.phone'],nationalId:answers[prefix+'.nationalId']};}
 const members={father:member('father'),mother:member('mother'),siblings:[],children:[]};
 for(let i=0;i<20;i++){if(answers['sibling.'+i+'.name'])members.siblings.push(member('sibling.'+i));if(answers['child.'+i+'.name'])members.children.push(member('child.'+i));}
 return registrationRow(SCHEMA,answers,members);
}
function exportCsv(){
 const state=load();if(!state||state.state!=='READY')throw Error('Collection not ready.');const form=FormApp.openById(state.formId),responses=form.getResponses();if(!responses.length)throw Error('No responses to export.');
 const rows=responses.map(function(response){return responseRow(response,state);});rows.forEach(function(row){csv(SCHEMA,row);});
 const quote=function(value){return '"'+String(value||'').replace(/"/g,'""')+'"';};
 const content='\uFEFF'+[SCHEMA.headers].concat(rows.map(function(row){return SCHEMA.headers.map(function(key){return row[key]||'';});})).map(function(row){return row.map(quote).join(',');}).join('\r\n')+'\r\n';
 const file=DriveApp.createFile('church-person-360.csv',content,'text/csv');console.log('CHURCH_CSV '+file.getUrl());
}

return {create:create,verify:verify,exportCsv:exportCsv};
})();
function createChurchWideForm(){MORIAH_CHURCH_WIDE.create();}
function verifyChurchWideForm(){MORIAH_CHURCH_WIDE.verify();}
